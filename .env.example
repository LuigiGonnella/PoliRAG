APP_NAME=PoliRAG Agent
ENVIRONMENT=development

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=uni_docs

LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro

HF_API_TOKEN=
# Docker maps HF_API_TOKEN to HF_TOKEN for FastEmbed/Hugging Face Hub downloads.
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GEMINI_API_KEY=
TAVILY_API_KEY=

ENABLE_WEB_FALLBACK=true
ENABLE_PYTHON_TOOL=false
RETRIEVAL_TOP_K=25
RERANK_TOP_L=5
RERANK_FALLBACK_THRESHOLD=0.45
AGENT_RESPONSE_TIMEOUT_SECONDS=180
LLM_REQUEST_TIMEOUT_SECONDS=60
WEB_SEARCH_TIMEOUT_SECONDS=12
MAX_HISTORY_MESSAGES=16
AUTO_CREATE_PAYLOAD_INDEXES=true

# Ingestion scripts only. The deployed API course catalog is static/Qdrant-based.
DATA_DIR=data/raw
FRONTEND_DIR=frontend
SESSION_DB_PATH=data/app_sessions.sqlite
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
